# Vorlage für /etc/wir-notify.env (auf dem Pi, chmod 600, NICHT ins Repo)
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# dieselben Schlüssel wie bei wir-push (sonst passen die Abos nicht)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com
PUSH_SUBS_COLLECTION=push_subs
PUSH_SUBS_USER_FIELD=user
