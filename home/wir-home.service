[Unit]
Description=Wir-App Zuhause (Brücke zu Home Assistant, Testmodus ohne HA)
After=network-online.target pocketbase.service
Wants=network-online.target

[Service]
User=pingu
WorkingDirectory=/home/pingu/F-r-dich/home
EnvironmentFile=/etc/wir-home.env
Environment=NODE_ENV=production TZ=Europe/Berlin
ExecStart=/usr/bin/node /home/pingu/F-r-dich/home/index.js
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
