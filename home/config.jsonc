// ============================================================================================
// Zuhause – Konfiguration UND Freigabeliste (keine Geheimnisse hier, die Datei ist öffentlich!)
//
// - Nur was hier steht, kann die App sehen und schalten. Alles andere lehnt der Server ab.
// - Ändern: Datei auf GitHub bearbeiten (Stift-Symbol) -> "Commit changes". Nach ≤ 2 Minuten holt der
//   Server die Änderung, der Dienst wir-home startet neu und die App zeigt sie sofort.
// - Zeilen, die mit // anfangen, sind Kommentare. Sonst normales JSON: Texte in "…", Kommas zwischen Einträgen,
//   KEIN Komma nach dem letzten Eintrag einer Liste.
// - entity_id findest du in Home Assistant unter Einstellungen -> Geräte & Dienste -> Entitäten (Spalte "Entitäts-ID").
// - Symbole ("icon"): bulb flame film book moon power sunrise clock home heart coffee fan stars tv window door
//                     thermo bolt sun cal alarm
// - Farben als Hex ("#ffb35c"). Im Testmodus (ohne HA-Token) wird alles hier simuliert.
// Ausführlich: pocketbase/ANLEITUNG.md, Abschnitt "Zuhause (Aurora)".
// ============================================================================================
{
  // Wetter (Open-Meteo, ohne Schlüssel, auf dem Server zwischengespeichert)
  "wetter": { "ort": "Kiel", "lat": 54.3233, "lon": 10.1228 },

  // Lampen (Balken "Licht"). Die Leuchtfarbe kommt aus Home Assistant (rgb_color bzw. color_temp_kelvin);
  // "farbe" gilt nur, solange die Lampe keine Farbe meldet. "test": Startzustand im Testmodus.
  "lampen": [
    { "name": "Bett",  "entity_id": "light.bett",  "farbe": "#ff9a52", "test": { "an": true,  "helligkeit": 45, "farbe": "#ff7828" } },
    { "name": "Küche", "entity_id": "light.kuche", "farbe": "#ffd9a8", "test": { "an": false, "helligkeit": 60, "farbe": "#ffd9a8" } },
    { "name": "Tisch", "entity_id": "light.tisch", "farbe": "#ffb35c", "test": { "an": true,  "helligkeit": 50, "farbe": "#ff9646" } }
  ],

  // Farbnamen unter den Lampen (sonst wird ein Name aus dem Farbton bzw. Weißton gebildet), z. B. { "#ff7828": "Glut" }
  "farbnamen": {},

  // Geräte (switch.…, input_boolean.…, fan.…) – gibt es noch keine, daher ausgeblendet. Beispiel:
  // { "name": "Kaffeemaschine", "entity_id": "switch.kaffeemaschine", "icon": "coffee", "farbe": "#ffb35c", "watt": 900 }
  "geraete": [],

  // Fernseher (Xiaomi MiTV-MSSP3, Android TV über "Android TV Remote").
  // "remote" = remote.… für Fernbedienungstasten und App-Start, "cast" = Google-Cast-Entität desselben Fernsehers
  // (nur lesen: was gerade läuft, Titel, Play/Pause-Zustand). Apps: "start" = Startlink (Deep Link) für remote.turn_on,
  // "paket" = Android-Paketname, an dem die laufende App erkannt wird (Attribut current_activity bzw. app_id).
  // Startlinks aus https://www.home-assistant.io/integrations/androidtv_remote/ und der Community-Liste
  // "Android TV Remote – App Links/Deep Linking" (community.home-assistant.io/t/567921).
  // "quellen" = Eingänge für select_source, genau so geschrieben wie in HA (Android TV Remote meldet keine -> ausgeblendet).
  // "an_skript" = Einschalt-Skript aus dem HA-Paket (Magic Packet + turn_on alle 2 s, bis er an ist) – Ein-Knopf, App-Kacheln
  // und Filmabend schalten darüber ein. "adb" / "wol" = Android-Debug-Bridge- bzw. Wake-on-LAN-Entität, NUR für wir-home
  // (Titel lesen, wecken), nie für die App. "auto" = wir-home sucht sie selbst in HA, sonst entity_id eintragen.
  "fernseher": {
    "name": "Fernseher",
    "entity_id": "media_player.fernseher",
    "remote": "remote.fernseher",
    "cast": "media_player.mitv_mssp3",
    "an_skript": "script.wir_tv_an",
    "adb": "auto",
    "wol": "auto",
    "max_lautstaerke": 100,
    "apps": [
      { "name": "Netflix",       "farbe": "#e50914", "start": "netflix://",                  "paket": "com.netflix.ninja",                 "test": "Serie · Staffel 2, Folge 4" },
      { "name": "YouTube",       "farbe": "#ff3d3d", "start": "https://www.youtube.com",     "paket": "com.google.android.youtube.tv",     "test": "Video · 12:08" },
      { "name": "Prime Video",   "farbe": "#1f9dff", "start": "https://app.primevideo.com",  "paket": "com.amazon.amazonvideo.livingroom", "test": "Film · noch 1 h 12" },
      { "name": "Disney+",       "farbe": "#3d5bff", "start": "https://www.disneyplus.com",  "paket": "com.disney.disneyplus",             "test": "Film · noch 58 Min" },
      { "name": "ARD Mediathek", "farbe": "#2c6bff", "start": "https://www.ardmediathek.de", "paket": "de.swr.avp.ard.tv",                 "test": "Tagesschau" },
      { "name": "ZDF",           "farbe": "#ff8a00", "start": "https://www.zdf.de/filme",    "paket": "com.zdf.android.mediathek",         "test": "Live" },
      { "name": "Spotify",       "farbe": "#1ed760", "start": "spotify://",                  "paket": "com.spotify.tv.android",            "test": "Musik" },
      { "name": "Twitch",        "farbe": "#9146ff", "start": "twitch://home",               "paket": "tv.twitch.android.app",             "test": "Stream" }
    ],
    "quellen": []
  },

  // Szenen: entweder "entity_id" (scene.… oder script.… aus HA) oder "aktionen" (was die Szene schaltet).
  // Die fünf Skripte kommen aus dem HA-Paket ha/packages/wir.yaml (Farben/Helligkeiten dort ändern).
  "szenen": [
    { "name": "Gemütlich",  "icon": "flame", "farbe": "#ff8a3c", "entity_id": "script.wir_gemuetlich" },
    // "fernseher": wir-home schaltet dazu den Fernseher ein, öffnet die App, setzt Lautstärke und Bildhelligkeit (0–100, 50 = normal)
    { "name": "Filmabend",  "icon": "film",  "farbe": "#7b5cff", "entity_id": "script.wir_filmabend", "fernseher": { "app": "Netflix", "lautstaerke": 35, "helligkeit": 50 } },
    { "name": "Lesen",      "icon": "book",  "farbe": "#ffc27a", "entity_id": "script.wir_lesen" },
    { "name": "Gute Nacht", "icon": "moon",  "farbe": "#5b6cff", "entity_id": "script.wir_gute_nacht", "fernseher": { "app": "Netflix", "lautstaerke": 20, "helligkeit": 0 } },
    { "name": "Alles aus",  "icon": "power", "farbe": "#6b7085", "entity_id": "script.wir_alles_aus" }
  ],

  // Routinen = Automationen in HA (Schalter aktiv/inaktiv) – gibt es noch keine, daher ausgeblendet. Beispiel:
  // { "name": "Abends dimmen", "entity_id": "automation.abends_dimmen", "info": "täglich · 22:00", "icon": "moon" }
  "routinen": [],

  // Raumklima + Strom (sensor.…). Leer ("") = ausgeblendet. Thermometer: SONOFF SNZB-02D „Temp“.
  "klima": {
    "temperatur":  "sensor.temp_temperatur",
    "luftfeuchte": "sensor.temp_luftfeuchtigkeit",
    "co2":         "",
    "strom_heute": "",
    "leistung":    ""
  },

  // Sensoren (binary_sensor.…) als Hinweise auf Start. "art": fenster | tuer | bewegung | sonstiges.
  // Gibt es noch keine. Beispiel: { "name": "Fenster", "entity_id": "binary_sensor.fenster", "art": "fenster" }
  "sensoren": [],

  // Lichtwecker (läuft lokal in HA, Paket ha/packages/wir.yaml). wir-home setzt diese Helfer aus den Wecker-Einstellungen
  // der App (der erste eingeschaltete Wecker der Liste bestimmt Zeit und Tage). Die App darf sie NICHT direkt schalten;
  // "Weckvorgang testen" startet nur "test" mit "test_sekunden".
  "wecker": {
    "aktiv":     "input_boolean.wir_wecker_aktiv",
    "aussetzen": "input_boolean.wir_wecker_aussetzen",
    "zeit":      "input_datetime.wir_wecker_zeit",
    "vorlauf":   "input_number.wir_wecker_vorlauf",
    "tage": ["input_boolean.wir_wecker_mo", "input_boolean.wir_wecker_di", "input_boolean.wir_wecker_mi", "input_boolean.wir_wecker_do",
             "input_boolean.wir_wecker_fr", "input_boolean.wir_wecker_sa", "input_boolean.wir_wecker_so"],
    "test": "script.wir_sonnenaufgang",
    "test_sekunden": 60
  },

  // Kalender: "automatisch": true = alle calendar.… aus HA (nur lesen). "quellen" ordnet einzelne Kalender zu
  // (z. B. { "entity_id": "calendar.ida", "wer": "i" }); "wer": d = Daniel, i = Ida, g = gemeinsam,
  // nicht eingetragene bekommen "standard". "farben": Farbe je Zuordnung, leer ("") = Farbe der Farbwelt.
  // Gibt es in HA keinen Kalender, bleiben die "testtermine" sichtbar (Kalender im Testmodus).
  "kalender": {
    "automatisch": true,
    "standard": "g",
    "quellen": [],
    "farben": { "d": "", "i": "", "g": "" },
    "testtermine": [
      { "d": "2026-11-02", "t": "18:00", "e": "19:30", "n": "Training", "w": "d" },
      { "d": "2026-11-04", "t": "18:00", "e": "19:00", "n": "Training", "w": "d" },
      { "d": "2026-11-04", "t": "20:30", "e": "21:30", "n": "Videocall", "w": "g" },
      { "d": "2026-11-05", "t": "10:00", "e": "12:00", "n": "Vorlesung", "w": "i" },
      { "d": "2026-11-06", "t": "17:00", "e": "18:00", "n": "Lerngruppe", "w": "d" },
      { "d": "2026-11-09", "t": "09:30", "e": "10:00", "n": "Zahnarzt", "w": "d" },
      { "d": "2026-11-10", "t": "14:00", "e": "16:00", "n": "Seminar", "w": "i" },
      { "d": "2026-11-12", "t": "19:00", "e": "22:00", "n": "Spieleabend", "w": "i" },
      { "s": "2026-11-13", "to": "2026-11-15", "n": "Besuch Erlangen", "w": "g" },
      { "d": "2026-11-13", "t": "15:42", "e": "", "n": "Zug ab Kiel", "w": "d" },
      { "d": "2026-11-18", "t": "16:00", "e": "18:00", "n": "Prüfungsvorbereitung", "w": "d" },
      { "d": "2026-11-19", "t": "11:00", "e": "12:00", "n": "Sprechstunde", "w": "i" },
      { "d": "2026-11-21", "t": "20:00", "e": "", "n": "Kino", "w": "g" },
      { "d": "2026-11-24", "t": "18:00", "e": "19:30", "n": "Training", "w": "d" },
      { "s": "2026-11-27", "to": "2026-11-29", "n": "Besuch Kiel", "w": "g" },
      { "d": "2026-12-01", "t": "08:00", "e": "", "n": "Berufsschule", "w": "d" }
    ]
  },

  // Zuhause-Extras (Karten auf Start): Partner-Ecke, Abfahrten, Pakete, System-Status. Nichts davon geht in home_state –
  // die App fragt über PocketBase, wir-home prüft den Nutzer. Ausführlich: ANLEITUNG.md, Abschnitt "Zuhause-Extras".
  "extras": {
    // PocketBase-ID des Besitzers (Daniel): nur er sieht Pakete und System-Status (serverseitig geprüft)
    "besitzer": "dtm8ddyyr9ns4h3",

    // Abfahrten + "Fahrt zu …": Transitous (MOTIS, frei, deutschlandweit). v6.db.transport.rest gibt es nicht mehr.
    // Haltestellen wählt jede Person selbst in Zuhause → Einstellungen (gespeichert in home_prefs, nicht hier).
    // Zwischenspeicher pro Haltestelle, egal wie viele Handys offen sind; Anfragen nach außen gedrosselt.
    "abfahrten": { "quelle": "https://api.transitous.org", "cache_sekunden": 60, "anzahl": 5, "max_anfragen_pro_minute": 30 },

    // Pakete aus der HA-Integration 17TRACK (Aktion seventeentrack.get_packages). Zugestellte nach "zugestellt_tage" ausblenden.
    "pakete": { "aktiv": true, "cache_minuten": 10, "zugestellt_tage": 2 },

    // System-Status. "ha": Entitäten aus HA (nur lesen; "updates": "update.*" = alle Update-Entitäten mit Update verfügbar).
    // "schwellen": [gelb ab, rot ab]. "last_pro_kern" = 5-Minuten-Last geteilt durch Kerne. Backup-Alter in Tagen.
    // "push_rot_minuten": so lange rot -> ein Push an den Besitzer (0 = aus).
    "system": {
      "dienste": ["pocketbase", "wir-push", "wir-home", "wir-deploy.timer"],
      "repo": "/home/pingu/F-r-dich",
      "pocketbase": "/home/pingu/pb/pocketbase",
      "backups": "/home/pingu/backups",
      "ha": {
        "cpu_temp":   "sensor.system_monitor_prozessortemperatur",
        "cpu":        "sensor.system_monitor_prozessor_auslastung",
        "ram":        "sensor.system_monitor_arbeitsspeicher_auslastung",
        "festplatte": "sensor.system_monitor_massenspeicher_auslastung",
        "backup":     "sensor.backup_last_successful_automatic_backup",
        "updates":    "update.*"
      },
      "schwellen": {
        "cpu_temp":      [70, 80],
        "cpu":           [85, 95],
        "festplatte":    [80, 90],
        "ram":           [85, 95],
        "last_pro_kern": [1.5, 3],
        "backup_tage":   [2, 4]
      },
      "push_rot_minuten": 15
    }
  }
}
